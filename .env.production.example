# =============================================================================
# AutoFlowOps — Production Environment Template
# =============================================================================
# Copy this file to .env.production and fill in real values.
# Never commit .env.production to version control.
#
# Generate strong random secrets:
#   openssl rand -hex 32   → 64-character hex string (suitable for *_KEY vars)
#   openssl rand -base64 32 → base64 string
# =============================================================================

# --- PostgreSQL ---
# These are read by the db service (docker-compose.prod.yml).
# POSTGRES_USER and POSTGRES_PASSWORD must match the credentials in DATABASE_URL.
POSTGRES_DB=autoflowops
POSTGRES_USER=autoflowops
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Application ---
APP_NAME=AutoFlowOps
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

# --- Database ---
# Must use the same credentials as POSTGRES_USER / POSTGRES_PASSWORD above.
# The host is "db" — the Docker service name defined in docker-compose.prod.yml.
DATABASE_URL=postgresql+psycopg://autoflowops:REPLACE_WITH_STRONG_PASSWORD@db:5432/autoflowops

# --- Queue ---
# Redis is internal to docker-compose.prod.yml and is not published to the host.
REDIS_URL=redis://redis:6379/0
JOB_EXECUTION_MODE=celery

# --- CORS ---
# Set to your public domain (must match the domain in Caddyfile).
FRONTEND_URL=https://autoflowops.yourdomain.com

# --- JWT ---
# Use a different random value than APP_SECRET_KEY.
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_64_CHAR_HEX
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Bootstrap admin account ---
# Created automatically on first startup when the users table is empty.
# Ignored on all subsequent startups — change these before the first run.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_NAME=Admin

# --- Security ---
ENABLE_SSRF_PROTECTION=true
ALLOW_PRIVATE_NETWORK_TARGETS=false

# --- Rate limiting ---
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=120

# --- Logging ---
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=UTC
