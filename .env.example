APP_NAME=AutoFlowOps
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-me-before-production

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://autoflowops:autoflowops@db:5432/autoflowops

REDIS_URL=redis://redis:6379/0
JOB_EXECUTION_MODE=celery

# JWT authentication (active in v0.2.0).
# Change JWT_SECRET_KEY to a strong random value before any deployment.
JWT_SECRET_KEY=change-me-before-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap admin account — created on first startup when no users exist.
# Change these values before deploying. Ignored once the first user is created.
ADMIN_EMAIL=admin@autoflowops.local
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

DEFAULT_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

MAX_WEBHOOK_PAYLOAD_BYTES=1048576
MAX_RESPONSE_PREVIEW_BYTES=8192
DEFAULT_JOB_TIMEOUT_SECONDS=30
DEFAULT_JOB_RETRY_COUNT=2

ENABLE_SIGNUP=false
ENABLE_DEMO_MODE=true

# SSRF protection for HTTP jobs.
# When ENABLE_SSRF_PROTECTION=true (default), job URLs that resolve to private
# or internal network ranges are blocked. Set ALLOW_PRIVATE_NETWORK_TARGETS=true
# only in controlled development environments.
ENABLE_SSRF_PROTECTION=true
ALLOW_PRIVATE_NETWORK_TARGETS=false

# In-memory rate limiting (per API process).
# For multi-replica deployments, replace with a Redis-backed implementation.
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=120
