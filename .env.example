APP_NAME=AutoFlowOps
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-me-before-production

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://autoflowops:autoflowops@db:5432/autoflowops

REDIS_URL=redis://redis:6379/0

# JWT authentication — not active in v0.1.0 (no auth layer yet).
# These variables are reserved for the upcoming authentication feature.
# Change JWT_SECRET_KEY to a strong random value before enabling auth in production.
JWT_SECRET_KEY=change-me-before-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DEFAULT_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

MAX_WEBHOOK_PAYLOAD_BYTES=1048576
MAX_RESPONSE_PREVIEW_BYTES=8192
DEFAULT_JOB_TIMEOUT_SECONDS=30
DEFAULT_JOB_RETRY_COUNT=2

ENABLE_SIGNUP=false
ENABLE_DEMO_MODE=true
